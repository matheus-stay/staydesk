<%# Fica em custom/app/views/conversation_reply_mailer/ (sem "mailers/"):
    o produto acrescenta app/views/mailers ao fim dos caminhos de view, então o
    prefixo que vale para este mailer é o nome dele, sem a pasta. %>
<%# Resposta ao cliente no canal de e-mail, dentro do layout da marca. O pedido
    de avaliação sai como bloco próprio, não como um link solto no meio do texto. %>
<% if @message.content_attributes['staydesk_aviso'] == 'recebimento' %>
  <%= render 'staydesk_recebimento', texto: @message.outgoing_content.html_safe, dados: staydesk_dados_do_chamado(@conversation, @inbox), painel: @staydesk_painel %>
<% elsif @message.input_csat? %>
  <%= render 'staydesk_csat', link: @conversation.csat_survey_link, mensagem: @inbox.csat_config&.dig('message') %>
<% elsif @message.content_attributes.dig('email', 'html_content', 'reply').present? %>
  <%= @message.content_attributes.dig('email', 'html_content', 'reply').html_safe %>
<% elsif @message.content %>
  <%= @message.outgoing_content.html_safe %>
<% end %>
<% if @large_attachments.present? %>
  <p style="margin:18px 0 0; font-size:14px; color:#5B6478;"><%= t('staydesk.email.attachments') %></p>
  <% @large_attachments.each do |attachment| %>
    <p style="margin:4px 0 0;"><a href="<%= attachment.file_url %>" target="_blank" rel="noopener" style="color:#545DFF;"><%= attachment.file.filename.to_s %></a></p>
  <% end %>
<% end %>
