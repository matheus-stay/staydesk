<%# O aviso de recebimento com cara de protocolo: o texto configurado, os dados
    do chamado e o caminho para acompanhar, em vez de uma linha solta. %>
<p style="margin:0 0 18px; font-size:15px; line-height:1.6; color:#1F2937;"><%= texto %></p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#F7F8FE; border:1px solid #E3E7F2; border-radius:12px;">
  <tr>
    <td style="padding:18px 22px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
      <p style="margin:0 0 12px; font-size:12px; letter-spacing:0.06em; text-transform:uppercase; color:#8A93A8;"><%= t('staydesk.email.recebimento.titulo') %></p>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="font-size:14px; color:#1F2937;">
        <% dados.each do |rotulo, valor| %>
          <tr>
            <td style="padding:3px 0; color:#6B7280; white-space:nowrap;"><%= rotulo %></td>
            <td style="padding:3px 0 3px 16px; text-align:right;"><strong style="color:#1B2559;"><%= valor %></strong></td>
          </tr>
        <% end %>
      </table>
    </td>
  </tr>
</table>
<% if painel.present? %>
  <p style="margin:22px 0 4px; text-align:center;">
    <a href="<%= painel %>" target="_blank" rel="noopener"
       style="display:inline-block; padding:12px 26px; border-radius:10px; background-color:#545DFF; color:#FFFFFF; font-size:15px; font-weight:600; text-decoration:none;"><%= t('staydesk.email.recebimento.botao') %></a>
  </p>
  <p style="margin:8px 0 0; text-align:center; font-size:12px; color:#8A93A8;"><%= t('staydesk.email.recebimento.dica') %></p>
<% end %>
